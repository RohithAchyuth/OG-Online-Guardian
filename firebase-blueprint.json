{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile and organization role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "organizationName": { "type": "string" },
        "organizationId": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "fullName", "organizationName", "organizationId", "role", "createdAt"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Multi-tenant enterprise boundary for digital risk protection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerUid": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "ownerUid", "createdAt"]
    },
    "OrganizationMember": {
      "title": "OrganizationMember",
      "description": "Enterprise organization member role mapping",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "role": { "type": "string" },
        "joinedAt": { "type": "string" }
      },
      "required": ["uid", "role", "joinedAt"]
    },
    "BrandProfile": {
      "title": "BrandProfile",
      "description": "Registered legitimate corporate brand profile and whitelist",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "brandName": { "type": "string" },
        "websiteUrl": { "type": "string" },
        "industry": { "type": "string" },
        "country": { "type": "string" },
        "description": { "type": "string" },
        "approvedAliases": { "type": "array" },
        "approvedKeywords": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "organizationId", "brandName", "websiteUrl", "createdAt"]
    },
    "SocialFinding": {
      "title": "SocialFinding",
      "description": "Potential social profile impersonation case",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brandId": { "type": "string" },
        "platform": { "type": "string" },
        "accountName": { "type": "string" },
        "username": { "type": "string" },
        "profileUrl": { "type": "string" },
        "riskScore": { "type": "number" },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "similarityScore": { "type": "number" },
        "evidenceSummary": { "type": "string" },
        "detectedAt": { "type": "string" }
      },
      "required": ["id", "brandId", "platform", "accountName", "username", "riskScore", "severity", "status"]
    },
    "AppFinding": {
      "title": "AppFinding",
      "description": "Potential unauthorized mobile app candidate",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brandId": { "type": "string" },
        "platform": { "type": "string" },
        "appName": { "type": "string" },
        "publisherName": { "type": "string" },
        "packageOrBundleId": { "type": "string" },
        "storeUrl": { "type": "string" },
        "riskScore": { "type": "number" },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "publisherMismatch": { "type": "boolean" },
        "detectedAt": { "type": "string" }
      },
      "required": ["id", "brandId", "platform", "appName", "packageOrBundleId", "riskScore", "severity", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security analyst audit entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "entityId": { "type": "string" },
        "performedBy": { "type": "string" },
        "timestamp": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "action", "entityId", "performedBy", "timestamp", "details"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private security analyst user profile"
    },
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Multi-tenant enterprise organizations"
    },
    "/organizations/{orgId}/members/{memberId}": {
      "schema": "OrganizationMember",
      "description": "Organization membership credentials"
    },
    "/organizations/{orgId}/brands/{brandId}": {
      "schema": "BrandProfile",
      "description": "Brand profiles and whitelist registry"
    },
    "/organizations/{orgId}/socialFindings/{findingId}": {
      "schema": "SocialFinding",
      "description": "Social media look-alike findings"
    },
    "/organizations/{orgId}/appFindings/{appFindingId}": {
      "schema": "AppFinding",
      "description": "Mobile application store threat findings"
    },
    "/organizations/{orgId}/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Cryptographically auditable incident logs"
    }
  }
}
